# ─────────────────────────────────────────────────────────────────────────────
# Lead delivery (server-side only — never expose these to the client)
# ─────────────────────────────────────────────────────────────────────────────
# READ THIS BEFORE DEPLOYING.
#
# The endpoint /api/lead validates every request and answers { ok: true }. It
# then tries, in parallel:
#   • Telegram    — TELEGRAM_BOT_TOKEN + TELEGRAM_CHAT_ID
#   • webhook     — LEAD_WEBHOOK_URL (Bitrix24 / amoCRM / Make / n8n)
#   • local file  — data/leads/YYYY-MM-DD.jsonl
#
# If NONE of them is configured the lead is captured NOWHERE. On a serverless
# host the local-file fallback cannot help either, because the deployment
# filesystem is read-only — so the visitor sees a success screen and the lead is
# lost. The endpoint reports this honestly as { ok: true, delivered: false }, and
# the form then shows the phone and WhatsApp instead of a plain thank-you.
#
# => Configure at least one channel below before going live.
#
# (There used to be LEAD_EMAIL_* variables documented here. They were never read
# by any code, so they are gone: a deployer who filled them in would have
# believed e-mail delivery worked.)

# Public site URL: canonical URLs, sitemap, Open Graph, robots.txt.
# On Vercel you can leave this empty — the deployment's own domain is detected
# automatically at build time. Set it for a custom domain.
NEXT_PUBLIC_SITE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Sales contacts. These are the values the site actually displays, so they are
# the first thing to replace before launch.
# ─────────────────────────────────────────────────────────────────────────────
# Shown in the header, the footer and the contacts page, exactly as written.
NEXT_PUBLIC_SALES_PHONE=+7 (700) 123-45-67
# Digits only, no "+", used to build wa.me links.
NEXT_PUBLIC_WHATSAPP=77001234567
NEXT_PUBLIC_SALES_EMAIL=sales@qonys.kz
# Optional: external map/route link. Without it the site shows its own schematic
# area map instead of a third-party embed.
NEXT_PUBLIC_MAP_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Delivery channels — fill at least one
# ─────────────────────────────────────────────────────────────────────────────

# Telegram: create a bot with @BotFather, add it to the sales group, get the chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Generic webhook (Bitrix24 / amoCRM / Make / n8n inbound hook)
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# Optional: override where JSON-lines lead files are written.
# Not usable on serverless hosts (read-only filesystem) — use it on a VPS or
# Docker deployment as a safety net alongside Telegram or a webhook.
LEAD_STORE_DIR=
