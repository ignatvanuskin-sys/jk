# ─────────────────────────────────────────────────────────────────────────────
# Lead delivery integration (server-side only — never expose these to the client)
# ─────────────────────────────────────────────────────────────────────────────
# The site works without any of these. If a value is empty, the /api/lead route
# still validates and accepts the lead and writes it to data/leads/*.jsonl.
# Fill the ones you need for a real launch.

# Public site URL (used for canonical URLs, sitemap, Open Graph absolute URLs).
# example.com is IANA-reserved for documentation — replace it with the real domain.
NEXT_PUBLIC_SITE_URL=https://example.com

# Telegram: create a bot with @BotFather, add it to the sales group, get chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Generic webhook (Bitrix24 / amoCRM / Make / n8n inbound hook)
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# E-mail notification (requires an SMTP relay or transactional provider endpoint)
LEAD_EMAIL_API_URL=
LEAD_EMAIL_API_KEY=
LEAD_EMAIL_TO=

# Optional: override where JSON-lines lead files are stored
LEAD_STORE_DIR=
